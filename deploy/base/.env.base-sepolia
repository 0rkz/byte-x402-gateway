# ============================================================
# BYTE x402 Gateway — Base SEPOLIA profile (DRY RUN, free faucet USDC)
# ============================================================
# Usage:
#   cp deploy/base/.env.base-sepolia .env
#   npm run build && npm start
#
# Run this FIRST. It exercises the entire 402 -> pay -> settle -> data flow on
# Base Sepolia with free faucet USDC, so a real dollar never moves while you
# prove the wiring. Then flip to .env.base-mainnet for the first real dollar.
# Same code, only this config differs (config.ts reads every var below).
# ------------------------------------------------------------

# HTTP server port
PORT=3402

# --- Receiving wallet -------------------------------------------------------
# Any address you control on Base Sepolia. Faucet USDC settles here; testnet
# funds have no value, so this is low-stakes. Can be the same wallet you'll use
# for mainnet PAY_TO (settlements just land on the testnet copy of USDC).
# FOUNDER ACTION: set a real 0x address.
PAY_TO_ADDRESS=0xFOUNDER_SET_TEST_RECEIVE_WALLET

# --- Network (CAIP-2) -------------------------------------------------------
# Base Sepolia testnet. (Base mainnet = eip155:8453, see .env.base-mainnet.)
NETWORK=eip155:84532

# --- USDC asset on Base Sepolia --------------------------------------------
# VERIFY-BEFORE-USE: this is the commonly-cited Circle test USDC on Base Sepolia,
# but CONFIRM it against the current Circle / Coinbase developer docs before the
# dry run (testnet token addresses do get rotated). It must implement EIP-3009
# transferWithAuthorization or the "exact" scheme cannot settle.
#   Confirm at: https://developers.circle.com/stablecoins/usdc-contract-addresses
#               (Base Sepolia row) and/or Coinbase x402 docs.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# EIP-712 domain — Circle test USDC mirrors mainnet: name="USD Coin", version="2".
# If the dry-run signature fails verification, re-confirm these two values
# against the deployed test contract (read name()/version() on Basescan).
USDC_DOMAIN_NAME=USDC
USDC_DOMAIN_VERSION=2

# --- Facilitator -----------------------------------------------------------
# xpay supports BOTH Base mainnet and Base Sepolia, zero-fee, gas-sponsored,
# NO API KEY. Using the same facilitator on testnet means the only difference
# between this dry run and the real run is the NETWORK + USDC_ADDRESS lines.
FACILITATOR_URL=https://facilitator.xpay.sh/
#
# ALTERNATIVE (testnet is open, no key): Coinbase CDP facilitator also supports
# base-sepolia. To try it instead:
#   FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# --- Pricing (atomic USDC base units, 6-decimal) ---------------------------
# Identical formula to mainnet so the dry run mirrors prod pricing.
# max(PRICE_FLOOR_ATOMIC, ceil(KB * PRICE_PER_KB_ATOMIC)); 5000 = $0.005/KB.
PRICE_PER_KB_ATOMIC=5000
PRICE_FLOOR_ATOMIC=1000

# --- Data source plumbing --------------------------------------------------
CACHE_TTL=60
COINGECKO_API_KEY=
FACT_ORACLE_URL=https://fact-oracle.payperbyte.io
EVIDENCE_PACK_URL=https://evidence-pack.payperbyte.io
USC_STATUTE_URL=https://usc-statute.payperbyte.io
DISCOVERY_API_URL=https://api.payperbyte.io

# --- Solana (off) -----------------------------------------------------------
SOLANA_PAY_TO=
