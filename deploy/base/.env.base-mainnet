# Secrets (CDP, CoinGecko if ever used) go in .env.attestation — this file is tracked and public.
# ============================================================
# BYTE x402 Gateway — Base MAINNET profile (REAL USDC settlement)
# ============================================================
# Usage:
#   cp deploy/base/.env.base-mainnet .env   (or: env $(grep -v '^#' deploy/base/.env.base-mainnet | xargs) npm start)
#   npm run build && npm start
#
# This profile points the gateway's SETTLEMENT layer at Base mainnet via the
# xpay facilitator. Nothing in src/ changes — config.ts reads every var below.
# The gateway FAILS CLOSED (503 on paid routes) until the facilitator is
# reachable, so a bad FACILITATOR_URL never gives data away for free.
#
# DECOUPLE NOTE: This rail earns revenue NOW. The BYTE Library Arbitrum
# contracts / audit gate DECENTRALIZATION, not this x402 payment path.
# ------------------------------------------------------------

# HTTP server port
PORT=3402

# --- Receiving wallet -------------------------------------------------------
# Wallet address that receives USDC on Base mainnet.
# Receiver = the BYTEDev 2-of-3 Safe on Base (owners = the 3 Ledgers, threshold 2).
# Deployed + smoke-tested 2026-06-08; verified getOwners=={L1,L2,L3}, threshold==2.
PAY_TO_ADDRESS=0xffFf4B8Da8C165B556326453446F6940C8AFE0DB

# --- Network (CAIP-2) -------------------------------------------------------
# Base mainnet. (Base Sepolia testnet = eip155:84532, see .env.base-sepolia.)
NETWORK=eip155:8453

# --- USDC asset on Base mainnet --------------------------------------------
# Circle-native USDC on Base (EIP-3009 transferWithAuthorization — required for
# the x402 "exact" scheme to settle gaslessly). VERIFIED address.
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# EIP-712 domain fields the facilitator uses to verify the EIP-3009 signature.
# Circle-native USDC on Base uses name="USD Coin", version="2". VERIFIED.
USDC_DOMAIN_NAME=USD Coin
USDC_DOMAIN_VERSION=2

# --- Facilitator -----------------------------------------------------------
# xpay: non-custodial, ZERO-FEE, gas-sponsored, NO API KEY required, supports
# Base mainnet + Base Sepolia, x402 v2. Fastest drop-in for the FIRST real
# settlement. The gateway talks to it via HTTPFacilitatorClient (any HTTP
# facilitator URL works).
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
#
# ALTERNATIVE (fee-free production w/ KYT + OFAC screening) — Coinbase CDP
# facilitator. Mainnet typically requires CDP API keys via the @coinbase/x402
# SDK (testnet is open). To use it instead:
#   FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
#   (and supply CDP credentials per Coinbase docs — out of scope for this env;
#    xpay needs no key, so use xpay for the first settlement.)

# --- Pricing (atomic USDC base units, 6-decimal) ---------------------------
# Per-feed price = max(PRICE_FLOOR_ATOMIC, ceil(KB * PRICE_PER_KB_ATOMIC)).
# 5000 atomic = $0.005 / KB. Floor 1000 atomic = $0.001 / request.
# Keep the FIRST mainnet settlement tiny — real money, small blast radius.
# Example feed prices at these rates:
#   x402-pulse (~3000B)  -> ~$0.015
#   earthquakes (~300B)  -> floor $0.001
PRICE_PER_KB_ATOMIC=5000
PRICE_FLOOR_ATOMIC=1000

# --- Data source plumbing (unchanged from prod) ----------------------------
# Cache TTL for upstream data sources, in SECONDS.
CACHE_TTL=60
# Optional CoinGecko key (higher rate limits for crypto-top100 / bespoke feeds).
COINGECKO_API_KEY=
# BYTE oracle proxies (POST oracle feeds). Defaults are the public prod hosts;
# override only if self-hosting.
FACT_ORACLE_URL=https://fact-oracle.payperbyte.io
EVIDENCE_PACK_URL=https://evidence-pack.payperbyte.io
USC_STATUTE_URL=https://usc-statute.payperbyte.io
# discovery-api the generic publisher-backed feeds proxy (read in feeds/generic.ts).
DISCOVERY_API_URL=https://api.payperbyte.io

# --- Solana (off for the Base settlement path) ------------------------------
# Leave SOLANA_PAY_TO empty to disable the Solana payment option.
SOLANA_PAY_TO=
FACILITATOR_AUTH=cdp

# --- ERC-8004 identity (registered 2026-06-11) -------------------------------
# agentId on the testnet Identity Registry 0x8004A818…BD9e (Arbitrum Sepolia).
# Read by the /.well-known/agent-registration.json route. Owner = deployer-v2.
ERC8004_AGENT_ID=194

# 402index.io domain-verification hash (public; served at /.well-known/402index-verify.txt) — 2026-06-14
INDEX402_VERIFY_HASH=14a28b6f3300dd160d9945af2720b13be37710df005c65c97ecce09f42496f2d

# fix(a) live companions (2026-07-28, base URLs - code appends /latest)
WEATHER_LIVE_URL=http://127.0.0.1:8101
EARTHQUAKES_LIVE_URL=http://127.0.0.1:8099
RUNTIME_EOL_LIVE_URL=http://127.0.0.1:8100
MERCHANT_SCREEN_SIGNER=0x86e67978B5DaE33d134c431A47c1B73365440b54

# --- Attester rotation boundary (2026-08-19 key-exposure rotation) -----------
# Public UTC timestamp of the moment the retired gateway attester stopped
# signing (systemd ExecMainStartTimestamp of the cutover restart). Read by
# attestationReceiptBlock() in src/index.ts to publish receipt.retiredAttesters
# in both .well-known manifests. Plain timestamp — safe in this public file.
# See ops/plans/ROTATION_RUNBOOK_V2.md Stage 5.
GATEWAY_ATTESTER_RETIRED_AT=2026-08-19T23:03:00Z
